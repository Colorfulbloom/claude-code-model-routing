__pycache__/
.DS_Store

# Test fixtures need their local settings layer, which a global ignore may drop
!tests/fixtures/**/.claude/settings.local.json
!app/fixtures/**/.claude/settings.local.json
!docs/design/usage-stack/demo-set/**/.claude/settings.local.json
# Captures regenerate from the design tools
docs/design/usage-stack/**/shots/
# Worktrees for agents and tracks
.claude/worktrees/
# Bar Tab build tools and caches stay inside the worktree
/.tools/
/.uv-cache/
/.uv-python/
/.npm-cache/
/.pw-browsers/
/app/.venv/
/app/.data/
/app/.coverage
/app/web/node_modules/
/app/web/playwright-report/
/app/web/test-results/
/app/web/coverage/
/app/.ruff_cache/
/app/.pytest_cache/
/app/.hypothesis/
/app/web/dist-sheet/
/app/web/.eslintcache

# Corpus fixtures keep their notes/ folders, which a local exclude may ignore.
!app/fixtures/**/notes/
!app/fixtures/**/notes/**
