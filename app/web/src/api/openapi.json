{
  "components": {
    "schemas": {
      "AppInfo": {
        "additionalProperties": false,
        "description": "Answer of ``GET /api/app``.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "claude_version": {
            "title": "Claude Version",
            "type": "string"
          },
          "editable_projects": {
            "items": {
              "type": "string"
            },
            "title": "Editable Projects",
            "type": "array"
          },
          "etag": {
            "title": "Etag",
            "type": "string"
          },
          "history": {
            "$ref": "#/components/schemas/HistoryInfo"
          },
          "ingest": {
            "$ref": "#/components/schemas/Ingest"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "pass_running_since": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pass Running Since"
          },
          "running": {
            "items": {
              "$ref": "#/components/schemas/RunningItem"
            },
            "title": "Running",
            "type": "array"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "to_fix_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Fix Count"
          }
        },
        "required": [
          "server_time",
          "instance",
          "claude_version",
          "as_of",
          "pass_running_since",
          "etag",
          "ingest",
          "history",
          "running",
          "to_fix_count",
          "editable_projects"
        ],
        "title": "AppInfo",
        "type": "object"
      },
      "BackupFailure": {
        "additionalProperties": false,
        "description": "A daily backup that did not finish. A later good copy clears it.",
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "no_space",
              "unwritable",
              "check_failed",
              "copy_failed"
            ],
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "at",
          "reason_code"
        ],
        "title": "BackupFailure",
        "type": "object"
      },
      "CrossCheck": {
        "additionalProperties": false,
        "description": "Result of comparing the active table with a second public list.",
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "state": {
            "enum": [
              "agree",
              "disagree",
              "not_checked"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "models"
        ],
        "title": "CrossCheck",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "The one error body. It never carries input or file paths.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "required": [
          "code",
          "path"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HistoryInfo": {
        "additionalProperties": false,
        "description": "What the store holds and how well it is kept.",
        "properties": {
          "backup_failed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BackupFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "first_ingest": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Ingest"
          },
          "kept_files": {
            "title": "Kept Files",
            "type": "integer"
          },
          "last_backup": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Backup"
          },
          "no_usage_rows": {
            "title": "No Usage Rows",
            "type": "integer"
          },
          "oldest": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest"
          },
          "pass_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PassError"
              },
              {
                "type": "null"
              }
            ]
          },
          "unreadable_files": {
            "title": "Unreadable Files",
            "type": "integer"
          }
        },
        "required": [
          "oldest",
          "first_ingest",
          "last_backup",
          "backup_failed",
          "pass_error",
          "unreadable_files",
          "kept_files",
          "no_usage_rows"
        ],
        "title": "HistoryInfo",
        "type": "object"
      },
      "Ingest": {
        "additionalProperties": false,
        "description": "Progress of the first read of the usage history.",
        "properties": {
          "bytes_done": {
            "title": "Bytes Done",
            "type": "integer"
          },
          "bytes_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bytes Total"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestError"
              },
              {
                "type": "null"
              }
            ]
          },
          "files_done": {
            "title": "Files Done",
            "type": "integer"
          },
          "files_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Files Total"
          },
          "retry_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          },
          "retrying": {
            "title": "Retrying",
            "type": "boolean"
          },
          "state": {
            "enum": [
              "waiting",
              "running",
              "done",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "files_done",
          "files_total",
          "bytes_done",
          "bytes_total",
          "error",
          "retrying",
          "retry_at"
        ],
        "title": "Ingest",
        "type": "object"
      },
      "IngestError": {
        "additionalProperties": false,
        "description": "Why a first-run ingest failed. ``file`` is None when the contract names none.",
        "properties": {
          "code": {
            "enum": [
              "config_dir_missing",
              "config_dir_unreadable",
              "store_unwritable",
              "store_damaged",
              "store_newer",
              "unexpected"
            ],
            "title": "Code",
            "type": "string"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          }
        },
        "required": [
          "code",
          "file"
        ],
        "title": "IngestError",
        "type": "object"
      },
      "MintRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/access/mint``.",
        "properties": {
          "project": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          }
        },
        "title": "MintRequest",
        "type": "object"
      },
      "MintResponse": {
        "additionalProperties": false,
        "description": "A fresh single-use code.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "MintResponse",
        "type": "object"
      },
      "ModelPrice": {
        "additionalProperties": false,
        "description": "One model's rates in USD per million tokens.",
        "properties": {
          "cache_read": {
            "title": "Cache Read",
            "type": "number"
          },
          "cache_write_1h": {
            "title": "Cache Write 1H",
            "type": "number"
          },
          "cache_write_5m": {
            "title": "Cache Write 5M",
            "type": "number"
          },
          "input": {
            "title": "Input",
            "type": "number"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "modifiers": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Modifiers",
            "type": "object"
          },
          "output": {
            "title": "Output",
            "type": "number"
          },
          "relative": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relative"
          },
          "source": {
            "enum": [
              "model_pricing",
              "litellm",
              "last_good",
              "bundled"
            ],
            "title": "Source",
            "type": "string"
          },
          "tiers": {
            "items": {
              "$ref": "#/components/schemas/PriceTier"
            },
            "title": "Tiers",
            "type": "array"
          }
        },
        "required": [
          "model",
          "source",
          "input",
          "output",
          "cache_read",
          "cache_write_5m",
          "cache_write_1h",
          "tiers",
          "modifiers",
          "relative"
        ],
        "title": "ModelPrice",
        "type": "object"
      },
      "PassError": {
        "additionalProperties": false,
        "description": "A whole-pass failure after the first ingest. The next good pass clears it.",
        "properties": {
          "code": {
            "enum": [
              "config_dir_missing",
              "config_dir_unreadable",
              "store_unwritable",
              "store_damaged",
              "store_newer",
              "unexpected"
            ],
            "title": "Code",
            "type": "string"
          },
          "file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          }
        },
        "required": [
          "code",
          "file",
          "since"
        ],
        "title": "PassError",
        "type": "object"
      },
      "PriceTier": {
        "additionalProperties": false,
        "description": "Rates that apply once a prompt passes a size, in USD per million tokens.",
        "properties": {
          "cache_read": {
            "title": "Cache Read",
            "type": "number"
          },
          "cache_write_1h": {
            "title": "Cache Write 1H",
            "type": "number"
          },
          "cache_write_5m": {
            "title": "Cache Write 5M",
            "type": "number"
          },
          "input": {
            "title": "Input",
            "type": "number"
          },
          "output": {
            "title": "Output",
            "type": "number"
          },
          "prompt_tokens_over": {
            "title": "Prompt Tokens Over",
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens_over",
          "input",
          "output",
          "cache_read",
          "cache_write_5m",
          "cache_write_1h"
        ],
        "title": "PriceTier",
        "type": "object"
      },
      "PricesInfo": {
        "additionalProperties": false,
        "description": "Answer of ``GET /api/prices``.",
        "properties": {
          "as_of": {
            "format": "date",
            "title": "As Of",
            "type": "string"
          },
          "cross_check": {
            "$ref": "#/components/schemas/CrossCheck"
          },
          "etag": {
            "title": "Etag",
            "type": "string"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelPrice"
            },
            "title": "Models",
            "type": "array"
          },
          "source": {
            "enum": [
              "model_pricing",
              "litellm",
              "last_good",
              "bundled"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "as_of",
          "etag",
          "cross_check",
          "models"
        ],
        "title": "PricesInfo",
        "type": "object"
      },
      "Project": {
        "additionalProperties": false,
        "description": "One project in the picker.",
        "properties": {
          "display_path": {
            "title": "Display Path",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "running": {
            "title": "Running",
            "type": "boolean"
          },
          "state": {
            "enum": [
              "ok",
              "no_claude_folder",
              "folder_not_found"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "display_path",
          "state",
          "running"
        ],
        "title": "Project",
        "type": "object"
      },
      "ProjectList": {
        "additionalProperties": false,
        "description": "Answer of ``GET /api/projects``.",
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "title": "Projects",
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "title": "ProjectList",
        "type": "object"
      },
      "RunningItem": {
        "additionalProperties": false,
        "description": "One session that is running now.",
        "properties": {
          "project": {
            "title": "Project",
            "type": "string"
          },
          "session": {
            "title": "Session",
            "type": "string"
          }
        },
        "required": [
          "project",
          "session"
        ],
        "title": "RunningItem",
        "type": "object"
      },
      "SwapRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/access/swap``.",
        "properties": {
          "code": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "SwapRequest",
        "type": "object"
      },
      "SwapResponse": {
        "additionalProperties": false,
        "description": "Keys handed out after a code swap.",
        "properties": {
          "edit_keys": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Edit Keys",
            "type": "object"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          },
          "read_key": {
            "title": "Read Key",
            "type": "string"
          }
        },
        "required": [
          "read_key",
          "edit_keys",
          "instance",
          "project"
        ],
        "title": "SwapResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Bar Tab",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/access/mint": {
      "post": {
        "operationId": "mint_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MintRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MintResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Mint Code",
        "tags": [
          "access"
        ]
      }
    },
    "/api/access/swap": {
      "post": {
        "operationId": "swap_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SwapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Swap Code",
        "tags": [
          "access"
        ]
      }
    },
    "/api/app": {
      "get": {
        "operationId": "get_app",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 63,
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get App",
        "tags": [
          "app"
        ]
      }
    },
    "/api/prices": {
      "get": {
        "operationId": "get_prices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricesInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get Prices",
        "tags": [
          "app"
        ]
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "get_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get Projects",
        "tags": [
          "app"
        ]
      }
    }
  }
}
