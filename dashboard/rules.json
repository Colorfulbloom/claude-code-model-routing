    {
      "rule_id": "subagent-model-order",
      "key": "model",
      "scope": "agent",
      "layer_order": [
        "agent",
        "env",
        "default"
      ],
      "conditions": [
        {
          "layer": "agent",
          "models": [
            "*"
          ],
          "values": [
            "inherit"
          ],
          "status": "in_effect"
        },
        {
          "layer": "agent",
          "models": [
            "*"
          ],
          "status": "in_effect"
        },
        {
          "layer": "env",
          "models": [
            "*"
          ],
          "status": "in_effect"
        }
      ],
      "reason": "{agent} runs on {winner}. Its frontmatter model, inherit included, beats CLAUDE_CODE_SUBAGENT_MODEL, which beats the main model. A model passed at dispatch, or set by a mod's agent.spawn hook, beats all three, and the resolver can't see either.",
      "doc_url": "https://code.claude.com/docs/en/env-vars#variables",
      "quote": "Two sources take precedence over it: a model Claude passes when it spawns the agent, and a `model` field in the agent's definition, including `inherit`.",
      "experiment": "experiments/2026-10-29-subagent-model-order.json",
      "confidence": "tested",
      "verified_on": {
        "claude_version": "2.1.302",
        "date": "2026-10-29"
      }
    },
    {
      "rule_id": "subagent-model-force",
      "key": "model",
      "scope": "agent",
