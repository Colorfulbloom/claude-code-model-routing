          "status": "ignored"
        }
      ],
      "reason": "CLAUDE_CODE_SUBAGENT_MODEL_FORCE is on, so {agent} ignores the model in {file} and runs on {winner}.",
      "doc_url": "https://code.claude.com/docs/en/sub-agents#run-every-subagent-on-one-model",
      "quote": "While `CLAUDE_CODE_SUBAGENT_MODEL_FORCE` is on, Claude Code ignores the `model` field in subagent definitions, and Claude can't pass a model when it starts a subagent.",
      "experiment": null,
      "confidence": "documented",
      "verified_on": {
        "claude_version": "2.1.302",
        "date": "2026-10-29"
