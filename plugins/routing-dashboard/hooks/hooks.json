{
  "hooks": {
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/routing-dashboard", "session-end"]}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/routing-dashboard", "guard"], "if": "Bash(python3 *bin/routing-dashboard*)", "onFailure": "block"}]}
    ]
  }
}
